<?xml version="1.0" encoding="utf-8"?>
<!-- One settings category: name in a 340dp x 44dp pill (focus = white pill, dark text).
     44dp + 2dp + 2dp per row so all 9 categories fit on a 1080p screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
              android:focusableInTouchMode="true"
              android:focusable="true"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:background="@drawable/settings_category_bg"
              android:layout_width="340dp"
              android:layout_height="44dp"
              android:layout_marginTop="2dp"
              android:layout_marginBottom="2dp">
    <ImageView
        android:id="@+id/settings_image"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="20dp"
        android:visibility="gone"
        tools:ignore="ContentDescription"/>
    <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.MarqueeTextViewCompat
        android:id="@+id/settings_title"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="20dp"
        android:textSize="18sp"
        android:textAlignment="viewStart"/>
</LinearLayout>
