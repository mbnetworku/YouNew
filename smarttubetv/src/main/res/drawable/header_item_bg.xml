<?xml version="1.0" encoding="utf-8"?>
<!-- Sidebar entry background: a ring while it has the D-pad focus, a soft pill while its section is open. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/header_item_selected" />
    <item android:state_hovered="true" android:drawable="@drawable/header_item_current" />
    <item android:state_selected="true" android:drawable="@drawable/header_item_current" />
    <item android:drawable="@android:color/transparent" />
</selector>
