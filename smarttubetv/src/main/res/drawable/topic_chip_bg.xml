<?xml version="1.0" encoding="utf-8"?>
<!-- Home topic buttons (Music, Gaming...): liquid glass pill, bright glass when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#FFE3E8F2" />
            <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#33FFFFFF" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#47FFFFFF" android:endColor="#1AFFFFFF" />
            <stroke android:width="1dp" android:color="#59FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
