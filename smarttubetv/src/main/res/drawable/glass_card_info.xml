<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass strip under a video thumbnail (title and channel). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#0FFFFFFF" />
    <stroke android:width="1dp" android:color="#3DFFFFFF" />
    <corners android:topLeftRadius="6dp" android:topRightRadius="6dp"
             android:bottomLeftRadius="18dp" android:bottomRightRadius="18dp" />
</shape>
