<?xml version="1.0" encoding="utf-8"?>
<!-- YouNew: modern round buttons - a soft glass circle at rest, a bright ring when focused, hovered by the mouse or pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:constantSize="true">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/lb_control_button_color" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
            <size android:height="@dimen/lb_control_button_diameter" android:width="@dimen/lb_control_button_diameter" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="oval">
            <solid android:color="@color/lb_control_button_color" />
            <size android:height="@dimen/lb_control_button_diameter" android:width="@dimen/lb_control_button_diameter" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/lb_control_button_color" />
            <size android:height="@dimen/lb_control_button_diameter" android:width="@dimen/lb_control_button_diameter" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
            <size android:height="@dimen/lb_control_button_diameter" android:width="@dimen/lb_control_button_diameter" />
        </shape>
    </item>
</selector>
